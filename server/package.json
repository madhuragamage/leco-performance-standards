  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.3",
    "cors": "2.8.5",
    "dotenv": "16.4.7",
    "express": "5.1.0",
    "jsonwebtoken": "9.0.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/cors": "2.8.17",
    "@types/express": "5.0.1",
    "@types/jsonwebtoken": "9.0.9",
    "@types/node": "22.15.3",
    "prisma": "6.19.3",
    "tsx": "4.19.4",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
